.metadata

# Backup files
*.bak

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle cache
.gradle/

# Android build outputs
local.properties
android/build/
android/.kotlin/

# Native build output from NDK and CMake. Vendored plugin sources under
# third_party/ are compiled in place, so their intermediates land inside the
# repository rather than under /build/.
**/.cxx/
.cxx/
